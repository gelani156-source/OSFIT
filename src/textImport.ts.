import {
  uid,
  type ExerciseLine,
  type Program,
  type SetLine
} from './model'

const num = (s: string) => Number(s.replace(',', '.'))

const makeSet = (weight: number, reps: number): SetLine => ({
  id: uid(),
  weight,
  reps,
  done: false
})

const makeLine = (
  name: string,
  sets: SetLine[]
): ExerciseLine => ({
  id: uid(),
  name: name.trim(),
  sets
})

export function parseIronlogText(text: string): ExerciseLine[] {
  const result: ExerciseLine[] = []

  const days = /^(понедельник|вторник|среда|четверг|пятница|суббота|воскресенье)\s*[:.]?$/i

  for (const raw of text.split(/\r?\n/)) {
    let s = raw
      .replace(/^\s*(?:[-*•]\s*)?(?:\[\s*[xX]?\s*\]\s*)?/, '')
      .replace(/^\d+[.)]\s*/, '')
      .trim()

    if (!s || days.test(s)) continue

    const tempos: string[] = []

    s = s.replace(
      /\b\d+\s*(?:сек(?:унд[ыа]?)?|с)\b/gi,
      token => {
        const key = `TEMPO${String.fromCharCode(65 + tempos.length)}`
        tempos.push(token)
        return key
      }
    )

    const restore = (value: string) =>
      value.replace(/TEMPO([A-Z])/g, (_, letter: string) =>
        tempos[letter.charCodeAt(0) - 65] ?? ''
      )

    const expr = /(\d+(?:[.,]\d+)?)\s*(?:кг\s*)?(?:(\d+)\s*[/*×xх]\s*(\d+)|[\/×xх]\s*(\d+))/gi
    const matches = [...s.matchAll(expr)]

    if (!matches.length) {
      result.push(makeLine(restore(s), [
        makeSet(0, 8),
        makeSet(0, 8),
        makeSet(0, 8)
      ]))
      continue
    }

    const first = matches[0]
    const name = restore(
      s.slice(0, first.index).trim()
    ) || 'Упражнение'

    const sets: SetLine[] = []

    for (let i = 0; i < matches.length; i++) {
      const m = matches[i]
      const next = matches[i + 1]

      const tail = s.slice(
        (m.index ?? 0) + m[0].length,
        next?.index ?? s.length
      )

      const countReps = m[2] !== undefined
      const a = num(m[1])
      const count = countReps ? num(m[2]) : 1
      const reps = countReps ? num(m[3]) : num(m[4])

      const trailingWeight = tail.match(
        /^\s*(\d+(?:[.,]\d+)?)\s*(?:кг)?\s*$/i
      )

      const countFirst = !countReps && a <= 12 &&
        (trailingWeight || (!next && matches.length === 1 && a <= 6))

      const weight = countFirst
        ? (trailingWeight ? num(trailingWeight[1]) : 0)
        : a

      let repeat = countFirst ? a : count

      const explicit = tail.match(
        /\b(\d+)\s*подход(?:а|ов)?\b/i
      )

      if (explicit) repeat = num(explicit[1])

      repeat = Math.min(30, Math.max(1, repeat))

      if (!Number.isFinite(weight) ||
          !Number.isFinite(reps) ||
          reps <= 0 || reps > 300) continue

      for (let n = 0; n < repeat; n++) {
        sets.push(makeSet(weight, reps))
      }
    }

    if (sets.length) result.push(makeLine(name, sets))
  }

  return result
}

export function parseIronlogProgram(
  text: string,
  name = 'Импортированный план'
): Program {
  const exercises = parseIronlogText(text)

  if (!exercises.length) {
    throw new Error('Не удалось найти упражнения')
  }

  return {
    id: uid(),
    name: name.trim() || 'Импортированный план',
    createdAt: new Date().toISOString(),
    exercises
  }
}
